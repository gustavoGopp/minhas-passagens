# ==============================================================================
# minhas-passagens — variáveis de ambiente
# Copie para .env.local (nunca versionado). Valores reais ficam só nos painéis
# dos serviços (Vercel, Supabase, Cloudflare). Este arquivo só documenta nomes.
# ==============================================================================

# --- App -----------------------------------------------------------------------
# URL pública do app (opcional; usada em links de e-mail/Telegram).
# O login com Google usa a URL real de cada acesso, então não depende dela.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (M1) ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chaves de terceiros por usuário (BYOK) (M1) --------------------------------
# Chave mestra (32 bytes em base64) que cifra as chaves de API de cada usuário
# com AES-256-GCM. Gere com: openssl rand -base64 32
BYOK_MASTER_KEY=

# --- Extração com a API da Anthropic (M3) -------------------------------------
# A chave é por usuário (BYOK), guardada cifrada no banco. Estas variáveis só
# definem os modelos padrão; podem ser alteradas para self-host.
EXTRACTION_MODEL_DEFAULT=claude-haiku-5-5
EXTRACTION_MODEL_RETRY=claude-sonnet-5-5

# --- Notificações e agendador (M5) --------------------------------------------
# Não precisam de variável na Vercel: as chaves VAPID, o segredo do agendador,
# a URL do app e o bot do Telegram ficam em public.app_config, preenchidos pelo
# workflow "Supabase — notificações e agendador". O token do bot vai como
# segredo TELEGRAM_BOT_TOKEN no GitHub. Opcional, para sobrescrever:
TELEGRAM_BOT_TOKEN=
VAPID_SUBJECT=mailto:voce@exemplo.com
# E-mail de alerta (Resend). Opcional; sem domínio próprio só envia para o
# e-mail da sua conta Resend.
RESEND_API_KEY=
EMAIL_FROM="Minhas Passagens <onboarding@resend.dev>"

# --- E-mail de entrada (M7) -----------------------------------------------------
# Domínio raiz onde ficam os endereços u-<token>@<domínio>.
INBOUND_EMAIL_DOMAIN=
# Segredo compartilhado com o Email Worker da Cloudflare (HMAC-SHA256 do corpo).
INBOUND_WEBHOOK_SECRET=

# Opcional (Vercel): protege o vigia diário /api/jobs/watchdog. A Vercel envia
# "Authorization: Bearer <CRON_SECRET>" nas chamadas do cron.
CRON_SECRET=
