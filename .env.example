# ==============================================================================
# minhas-passagens — variáveis de ambiente
# Copie para .env.local (nunca versionado). Valores reais ficam só nos painéis
# dos serviços (Vercel, Supabase, Cloudflare). Este arquivo só documenta nomes.
# ==============================================================================

# --- App -----------------------------------------------------------------------
# URL pública do app (usada em links de e-mail/Telegram e no OAuth).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (M1) ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chaves de terceiros por usuário (BYOK) (M1) --------------------------------
# Chave mestra (32 bytes em base64) que cifra as chaves de API de cada usuário
# com AES-256-GCM. Gere com: openssl rand -base64 32
BYOK_MASTER_KEY=

# --- Extração com a API da Anthropic (M3) -------------------------------------
# A chave é por usuário (BYOK), guardada cifrada no banco. Estas variáveis só
# definem os modelos padrão; podem ser alteradas para self-host.
EXTRACTION_MODEL_DEFAULT=claude-haiku-5-5
EXTRACTION_MODEL_RETRY=claude-sonnet-5-5

# --- Agendador (M5) -------------------------------------------------------------
# Segredo que o pg_cron (Supabase) ou o Cloudflare Worker envia no header
# Authorization: Bearer <JOBS_SECRET> ao chamar /api/jobs/tick.
JOBS_SECRET=

# --- Notificações (M5) ----------------------------------------------------------
# Um único bot do app atende todos os usuários (Telegram não tem custo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Segredo enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Web Push (VAPID). Gere uma vez com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# E-mail de alerta (Resend, plano gratuito).
RESEND_API_KEY=
EMAIL_FROM="Minhas Passagens <alertas@exemplo.com.br>"

# --- E-mail de entrada (M7) -----------------------------------------------------
# Domínio raiz onde ficam os endereços u-<token>@<domínio>.
INBOUND_EMAIL_DOMAIN=
# Segredo compartilhado com o Email Worker da Cloudflare (HMAC-SHA256 do corpo).
INBOUND_WEBHOOK_SECRET=
